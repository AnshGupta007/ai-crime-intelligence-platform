{
    "runtime": "python_3_11",
    "command": "uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "build": "pip install -r requirements.txt",
    "port": 8000,
    "health_check": {
        "path": "/health",
        "interval": 30,
        "timeout": 3,
        "healthy_threshold": 2,
        "unhealthy_threshold": 3
    }
}
